{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glowtune",
  "version": "0.5.5",
  "identifier": "dev.preet.glowtune",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4QzRCOUY5MTZENjI4N0UKUldSK0tOWVcrYm5FQ0E1eGRhTTFMQ2E2dDJ3ejArQTA4UXdKMGs0Z0VuMmljcEg1Z0lRU2hIblkK",
      "endpoints": ["https://github.com/preetsaini2004/glowtune/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Glowtune",
    "copyright": "Copyright (c) 2026 Glowtune contributors. MIT License.",
    "category": "Music",
    "shortDescription": "Ambient edge glow, synced lyrics and a living desktop scene for your music.",
    "longDescription": "Glowtune follows whatever music is playing on your PC and lights up your screen edges in the album's colors, shows synced lyrics, and turns your desktop into a live music scene. Spotify, Apple Music, YouTube Music and SoundCloud can play inside Glowtune without ads. Everything stays on your PC.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
